# ── BLOCKSHORE server configuration ─────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=5421
# Production: bind to all interfaces behind your TLS proxy
HOST=127.0.0.1
# REQUIRED in production. Unset in development → embedded PGlite under .data/pglite
DATABASE_URL=
# Usernames (comma separated) that get administrator rights when they register
ADMIN_USERS=admin
# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Dev-only commands (teleport, give cash, force stage). Always off when NODE_ENV=production
DEV_COMMANDS=1
SESSION_DAYS=30
MAX_INSTANCES=40
LOG_LEVEL=info
# Browser origins allowed to use this server when the client is hosted elsewhere (comma separated)
# e.g. https://blockshore.vercel.app
ALLOWED_ORIGINS=
